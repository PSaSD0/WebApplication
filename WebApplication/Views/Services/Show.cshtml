@model ShawarmaDto
@{
    ViewBag.Title = Model.Title;
}

<a asp-action="Index" style="text-decoration: none; color: #666; display: inline-block; margin-bottom: 20px;">&larr; Назад к списку</a>

<div class="show-container">
    <div class="show-image">
        @if (!string.IsNullOrEmpty(Model.Photo))
        {
            <img src="~/img/@Model.Photo" alt="@Model.Title" />
        }
        else
        {
            <div style="background: #eee; height: 300px; display: flex; align-items: center; justify-content: center; border-radius: 12px; color: #999;">
                Фото отсутствует
            </div>
        }
    </div>

    <div class="show-info">
        <h2>@Model.Title</h2>

        <div style="margin-bottom: 20px;">
            @if (!string.IsNullOrEmpty(Model.DistrictName))
            {
                <span class="badge">Район: @Model.DistrictName</span>
            }

            <span class="badge" style="background-color: #e67e22; margin-left: 10px;">
                Оценка: @(Model.AverageRating > 0 ? Model.AverageRating.ToString("0.0") : "Нет оценок")
            </span>
        </div>
        <p style="font-size: 16px; color: #666; margin-top: 10px;">
            <strong>Адрес:</strong> @Model.Address
        </p>

        <p style="font-size: 18px; font-weight: 500; color: #555;">@Model.ShortDescription</p>
    </div>
</div>

<hr style="margin: 40px 0; border: 0; border-top: 1px solid #eee;" />

<h3>Отзывы посетителей</h3>

@{
    var reviews = ViewBag.Reviews as IEnumerable<WebApplication.Domain.Entities.Review>;
}

@if (reviews != null && reviews.Any())
{
    <div style="margin-top: 20px;">
        @foreach (var review in reviews)
        {
            <div style="background: white; padding: 15px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); margin-bottom: 15px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                    <strong style="color: var(--primary-color);">@review.User?.UserName</strong>
                    <span style="color: #e67e22; font-weight: bold; margin-left: 10px;">Оценка: @review.Rating</span>
                </div>
                <p>@review.Text</p>
            </div>
        }
    </div>
}
else
{
    <p style="color: #666; margin-top: 15px;">Отзывов пока нет. Будьте первым!</p>
}

<div style="margin-top: 30px; background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <h4 style="margin-bottom: 15px;">Оставить отзыв</h4>
        <form asp-action="AddReview" method="post">
            <input type="hidden" name="ShawarmaPlaceId" value="@Model.Id" />

            <div class="form-group">
                <label style="font-weight: bold;">Ваша оценка:</label>
                <select name="Rating" class="form-control" style="width: 100px;" required>
                    <option value="5">5</option>
                    <option value="4">4</option>
                    <option value="3">3</option>
                    <option value="2">2</option>
                    <option value="1">1</option>
                </select>
            </div>

            <div class="form-group">
                <textarea name="Text" class="form-control" rows="4" placeholder="Поделитесь впечатлениями..." required></textarea>
            </div>
            <button type="submit" class="btn">Отправить отзыв</button>
        </form>
    }
    else
    {
        <p style="text-align: center; margin: 0;">
            <a asp-controller="Account" asp-action="Login" style="color: var(--primary-color); font-weight: bold;">Войдите</a> или
            <a asp-controller="Account" asp-action="Register" style="color: var(--primary-color); font-weight: bold;">зарегистрируйтесь</a>, чтобы оставить отзыв.
        </p>
    }
</div>