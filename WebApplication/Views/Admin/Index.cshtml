@{
    ViewBag.Title = "Панель администратора";
    var districts = ViewBag.Districts as IEnumerable<District>;
    var places = ViewBag.ShawarmaPlaces as IEnumerable<ShawarmaPlace>;
}

<h2>Панель управления</h2>

<div style="margin-bottom: 40px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h3>Районы города</h3>
        <a asp-action="DistrictEdit" asp-route-id="0" class="btn">+ Добавить район</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: bold;">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (districts != null && districts.Any())
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in districts)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td style="display: flex; gap: 10px;">
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <a asp-action="DistrictEdit" asp-route-id="@item.Id" class="btn btn-outline" style="padding: 0 15px; font-size: 13px; height: 32px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0;">
                                    Изменить
                                </a>

                                <form asp-action="DistrictDelete" asp-route-id="@item.Id" method="post" style="margin: 0; display: flex;" onsubmit="return confirm('Удалить район?');">
                                    <button type="submit" class="btn btn-danger" style="padding: 0 15px; font-size: 13px; height: 32px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0;">
                                        Удалить
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>Районы пока не добавлены.</p>
    }
</div>

<div>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h3>Шаурмечные</h3>
        <a asp-action="ShawarmaEdit" asp-route-id="0" class="btn">+ Добавить шаурмечную</a>
    </div>

    @if (places != null && places.Any())
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Район</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in places)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@(item.District?.Title ?? "Не указан")</td>
                        <td style="display: flex; gap: 10px;">
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <a asp-action="ShawarmaEdit" asp-route-id="@item.Id" class="btn btn-outline" style="padding: 0 15px; font-size: 13px; height: 32px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0;">
                                    Изменить
                                </a>
    
                                <form asp-action="ShawarmaDelete" asp-route-id="@item.Id" method="post" style="margin: 0; display: flex;" onsubmit="return confirm('Удалить шаурмечную?');">
                                    <button type="submit" class="btn btn-danger" style="padding: 0 15px; font-size: 13px; height: 32px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0;">
                                        Удалить
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>Шаурмечные пока не добавлены.</p>
    }
</div>