@model District
@{
    ViewBag.Title = Model.Id == 0 ? "Добавить район" : "Редактировать район";
}

<h2>@ViewBag.Title</h2>

<form asp-action="DistrictEdit" method="post" style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); max-width: 500px;">

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="DateCreated" />

    <div class="form-group">
        <label asp-for="Title">Название района</label>
        <input asp-for="Title" class="form-control" placeholder="Например: Ленинский район" />
        <span asp-validation-for="Title" style="color: #e74c3c; font-size: 14px;"></span>
    </div>

    <div style="margin-top: 25px; display: flex; gap: 10px; align-items: center;">
        <button type="submit" class="btn" style="padding: 0 20px; height: 42px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0;">
            Сохранить
        </button>
        <a asp-action="Index" class="btn btn-danger" style="padding: 0 20px; height: 42px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0;">
            Отмена
        </a>
    </div>
</form>