@model ShawarmaPlace
@{
    var districts = ViewBag.Districts as IEnumerable<District>;
}
<h2>@(Model.Id == 0 ? "Добавить шаурмечную" : "Редактировать шаурмечную")</h2>

<form asp-action="ShawarmaEdit" method="post" enctype="multipart/form-data" style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="DateCreated" />
    <input type="hidden" asp-for="Photo" />

    <div class="form-group">
        <label asp-for="Title">Название заведения</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" style="color: red; font-size: 14px;"></span>
    </div>

    <div class="form-group">
        <label asp-for="DistrictId">Район</label>
        <select asp-for="DistrictId" class="form-control">
            <option value="">Выберите район</option>
            @if (districts != null)
            {
                foreach (var d in districts)
                {
                    <option value="@d.Id">@d.Title</option>
                }
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="ShortDescription">Краткое описание</label>
        <input asp-for="ShortDescription" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Address">Адрес</label>
        <input asp-for="Address" class="form-control" placeholder="г. Ижевск, ул. Ленина, д. 1" />
    </div>

    <div class="form-group">
        <label>Фото</label>
        <input type="file" name="titleImage" class="form-control" style="padding: 10px; border: 1px dashed #ccc;" />
        @if (!string.IsNullOrEmpty(Model.Photo))
        {
            <div style="margin-top: 10px;">
                <img src="~/img/@Model.Photo" width="150" style="border-radius: 8px;" />
            </div>
        }
    </div>

    <div style="margin-top: 25px; display: flex; gap: 10px; align-items: center;">
        <button type="submit" class="btn" style="padding: 0 20px; height: 42px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0;">
            Сохранить
        </button>
        <a asp-action="Index" class="btn btn-danger" style="padding: 0 20px; height: 42px; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0;">
            Отмена
        </a>
    </div>
</form>