@model IEnumerable<ShawarmaDto>

<nav>
    <ul>
        <li><a asp-controller="Services" asp-action="Index">Все шаурмечные</a></li>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <li class="dropdown" style="margin-left: 20px;">
                <a href="#" style="cursor: pointer; display: flex; align-items: center; gap: 5px;">
                    <span style="font-size: 18px;"></span> @User.Identity.Name ▾
                </a>

                <ul class="dropdown-content" style="min-width: 200px;">
                    <li>
                        <a asp-controller="Account" asp-action="Profile">
                            Мой профиль
                        </a>
                    </li>

                    @if (User.IsInRole("admin"))
                    {
                        <li>
                            <a asp-controller="Admin" asp-action="Index">
                                Админ-панель
                            </a>
                        </li>
                    }

                    <li style="border-top: 1px solid #eee;">
                        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                            <button type="submit" style="width: 100%; text-align: left; background: none; border: none; padding: 12px 20px; color: #e74c3c; cursor: pointer; font-weight: 600; font-family: inherit; font-size: 16px; transition: background 0.3s;">
                                Выйти
                            </button>
                        </form>
                    </li>
                </ul>
            </li>
        }
        else
        {
            <li style="margin-left: 20px;"><a asp-controller="Account" asp-action="Register" class="btn btn-outline" style="padding: 8px 15px; font-size: 14px;">Регистрация</a></li>
            <li><a asp-controller="Account" asp-action="Login" class="btn" style="padding: 8px 15px; font-size: 14px;">Войти</a></li>
        }
    </ul>
</nav>

<style>
    .dropdown-content button:hover {
        background-color: #f8f9fa !important;
    }
</style>