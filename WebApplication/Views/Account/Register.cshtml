@model RegisterViewModel
@{
    ViewBag.Title = "Регистрация";
}

<div style="max-width: 400px; margin: 50px auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
    <h2 style="text-align: center; margin-bottom: 30px;">Создать аккаунт</h2>

    <form asp-action="Register" method="post">
        <div asp-validation-summary="All" style="color: #e74c3c; margin-bottom: 15px; font-size: 14px;"></div>

        <div class="form-group">
            <label asp-for="UserName"></label>
            <input asp-for="UserName" class="form-control" placeholder="Придумайте логин" />
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" placeholder="example@mail.ru" />
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" placeholder="Минимум 6 символов" />
        </div>

        <div class="form-group">
            <label asp-for="PasswordConfirm"></label>
            <input asp-for="PasswordConfirm" class="form-control" placeholder="Повторите пароль" />
        </div>

        <button type="submit" class="btn" style="width: 100%; font-size: 16px; margin-bottom: 15px;">Зарегистрироваться</button>

        <div style="text-align: center;">
            <span style="color: #666;">Уже есть аккаунт?</span>
            <a asp-action="Login" style="color: var(--primary-color); text-decoration: none;">Войти</a>
        </div>
    </form>
</div>