@model ProfileViewModel
@{
    ViewBag.Title = "Мой профиль";
}

<div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 30px;">
    <h2>Личный кабинет</h2>
    <p style="font-size: 18px;"><strong>Логин:</strong> @Model.UserName</p>
    <p style="font-size: 18px;"><strong>Email:</strong> @Model.Email</p>
</div>

<h3 style="margin-bottom: 20px;">Мои отзывы (@Model.Reviews.Count())</h3>

@if (!Model.Reviews.Any())
{
    <p>Вы пока не оставили ни одного отзыва.</p>
}
else
{
    <div class="grid">
        @foreach (var review in Model.Reviews)
        {
            <div class="card" style="padding: 20px;">
                <h4 style="margin-bottom: 10px;">
                    <a asp-controller="Services" asp-action="Show" asp-route-id="@review.ShawarmaPlaceId" style="color: var(--primary-color); text-decoration: none;">
                        @review.ShawarmaPlaceTitle
                    </a>
                </h4>
                <p style="font-size: 12px; color: #999; margin-bottom: 15px;">@review.DateCreated.ToString("dd.MM.yyyy HH:mm")</p>
                <p style="color: #333;">@review.Text</p>
            </div>
        }
    </div>
}