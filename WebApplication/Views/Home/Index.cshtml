@{
    ViewBag.Title = "Главная";
}

<div style="text-align: center; padding: 50px 20px; background: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
    <h1 style="font-size: 48px; color: #d35400; margin-bottom: 20px;">Найди свою идеальную шаурму</h1>
    <p style="font-size: 18px; color: #666; margin-bottom: 30px; max-width: 600px; margin-left: auto; margin-right: auto;">
        Добро пожаловать на самый честный гид по шаурмечным города. Читайте отзывы, смотрите фото и выбирайте, где поесть сегодня.
    </p>
    <a asp-controller="Services" asp-action="Index" class="btn" style="font-size: 18px; padding: 15px 30px;">Смотреть все шаурмечные</a>
</div>